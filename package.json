  "dependencies": {
    "@bio-mcp/shared": "workspace:*",
    "@cloudflare/codemode": "0.1.1",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@types/node": "24.10.15",
    "typescript": "5.8.3",
    "wrangler": "4.115.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
