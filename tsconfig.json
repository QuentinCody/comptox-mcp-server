{
  "compilerOptions": {
    "target": "es2021", "lib": ["es2021"], "module": "es2022", "moduleResolution": "bundler",
    "resolveJsonModule": true, "allowSyntheticDefaultImports": true, "noEmit": true,
    "isolatedModules": true, "forceConsistentCasingInFileNames": true, "strict": true, "skipLibCheck": true
  },
  "include": ["worker-configuration.d.ts", "src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
